# Using lightweight docker image of node
FROM node:20-alpine AS base

# Update Alpine package manager and install bash for script compatibility
RUN apk update && apk add bash

# Install specific Yarn version
RUN rm -f /usr/local/bin/yarn
RUN npm install -g --force yarn

# Set the working directory inside the container
WORKDIR /usr/src/ultimate-backend-app

# Copy dependency files to the working directory
COPY package.json yarn.lock ./

# Install dependencies using Yarn with frozen lockfile to ensure consistency
RUN yarn --frozen-lockfile

# Copy all files from the local project directory to the container
COPY . .

# Expose port 8000 to allow external access to the application
EXPOSE 8000

# Define the default command to run the application in development mode
CMD [ "yarn", "dev" ]